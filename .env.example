# =============================================================================
# genki-reference — Environment Variables
# =============================================================================
#
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
#
# For Cloudflare Workers runtime secrets (GOOGLE_CLOUD_API_KEY,
# SENTRY_AUTH_TOKEN) also copy .dev.vars.example to .dev.vars.
#   cp .dev.vars.example .dev.vars
#
# =============================================================================

# === Supabase (REQUIRED) ===
# Create a project at https://supabase.com and copy these from
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# === Google Cloud TTS (REQUIRED for audio) ===
# Enable the Cloud Text-to-Speech API at https://console.cloud.google.com
# and create an API key restricted to that API.
# For plain `next dev` only -- in Workers this is set as a wrangler secret.
GOOGLE_CLOUD_API_KEY=<your-google-cloud-api-key>

# === Sentry (OPTIONAL -- error monitoring) ===
# Create a Next.js project at https://sentry.io and copy the DSN from
# Settings -> Projects -> <project> -> Client Keys.
NEXT_PUBLIC_SENTRY_DSN=

# SENTRY_AUTH_TOKEN is only needed at build time to upload source maps.
# Generate one at https://sentry.io/settings/auth-tokens/
# Set this in CI (e.g. GitHub Actions secret) or in .dev.vars for local builds.
SENTRY_AUTH_TOKEN=
